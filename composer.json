{
    "name": "hansendo/php-audio-edit-cli",
    "description": "Audio editing CLI tool using FrankenPHP and FFmpeg",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/console": "^7.0",
        "symfony/process": "^7.0"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    }
}
